<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wangheng.mapper.CouponStockMapper">

    <!-- 发放活动列表：公开查询，状态动态筛选 -->
    <select id="list" resultType="com.wangheng.pojo.CouponStock">
        select * from coupon_stock
        <where>
            <if test="status != null">and status = #{status}</if>
        </where>
        order by id desc
    </select>

    <!-- 商家优惠券管理：只看自己的活动（数据隔离） -->
    <select id="listOwn" resultType="com.wangheng.pojo.CouponStock">
        select * from coupon_stock
        <where>
            create_user_id = #{userId}
            <if test="status != null">and status = #{status}</if>
        </where>
        order by id desc
    </select>

</mapper>
